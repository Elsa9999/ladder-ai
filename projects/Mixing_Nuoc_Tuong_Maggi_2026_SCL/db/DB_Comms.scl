DATA_BLOCK "DB_Comms"
{ S7_Optimized_Access := 'False' }
VERSION : 0.1
// Khối dữ liệu đệm truyền thông (Modbus TCP Client/Server và Modbus RTU ATV12)
// Thiết kế Standard (Non-Optimized) để đảm bảo độ lệch địa chỉ byte (byte offset) cố định cho con trỏ Modbus
   STRUCT
      // 1. Cấu hình kết nối Modbus TCP Client (Giao tiếp từ PLC1 -> PLC2, sử dụng trên PLC1)
      MB_TCP_Client_Conn : TCON_IP_v4;   // Cấu trúc cấu hình kết nối TCP Client chuẩn Siemens
      
      // 2. Cấu hình kết nối Modbus TCP Server (Lắng nghe từ PLC1, sử dụng trên PLC2)
      MB_TCP_Server_Conn : TCON_IP_v4;   // Cấu trúc cấu hình kết nối TCP Server chuẩn Siemens
      
      // 3. Trạng thái điều phối và bộ đệm giao tiếp Modbus TCP Client
      TCP_Client : "UDT_ModbusTCP_Link";  // Quản lý trạng thái, nhãn bắt tay và bộ đệm gửi nhận
      
      // 4. Trạng thái điều phối và bộ đệm giao tiếp Modbus TCP Server
      TCP_Server : "UDT_ModbusTCP_Link";  // Quản lý trạng thái, nhãn bắt tay và bộ đệm lưu trữ dữ liệu chia sẻ
      
      // 5. Trạng thái và bộ đệm truyền thông Modbus RTU RS485 với biến tần Altivar 12 Bồn 2 (Chỉ chạy trên PLC1)
      VFD_Bon2 : "UDT_VFD_ATV12";         // Trạng thái và dữ liệu điều khiển biến tần
   END_STRUCT;
BEGIN
   // LƯU Ý QUAN TRỌNG: Các trường dữ liệu phức tạp của struct TCON_IP_v4 (như RemoteAddress.ADDR[1..4])
   // bắt buộc phải được gán động 1 lần duy nhất trong hàm khởi tạo FirstScan / OB100 để tránh lỗi cú pháp 
   // khi import file SCL tĩnh vào TIA Portal V18. Không khai báo gán tĩnh cho struct TCON_IP_v4 trong phần BEGIN của DB này.
   //
   // Mẫu mã nguồn gán tại FirstScan (OB1 / OB100):
   // IF "FirstScan" THEN
   //    "DB_Comms".MB_TCP_Client_Conn.InterfaceId := 64;
   //    "DB_Comms".MB_TCP_Client_Conn.ID := 5;
   //    "DB_Comms".MB_TCP_Client_Conn.ConnectionType := 11; // TCP
   //    "DB_Comms".MB_TCP_Client_Conn.ActiveEstablished := TRUE;
   //    "DB_Comms".MB_TCP_Client_Conn.RemoteAddress.ADDR[1] := 192;
   //    "DB_Comms".MB_TCP_Client_Conn.RemoteAddress.ADDR[2] := 168;
   //    "DB_Comms".MB_TCP_Client_Conn.RemoteAddress.ADDR[3] := 0;
   //    "DB_Comms".MB_TCP_Client_Conn.RemoteAddress.ADDR[4] := 2; // IP PLC2
   //    "DB_Comms".MB_TCP_Client_Conn.RemotePort := 502;
   //    "DB_Comms".MB_TCP_Client_Conn.LocalPort := 0;
   // END_IF;
END_DATA_BLOCK
