DATA_BLOCK "DB_Comms"
{ S7_Optimized_Access := 'False' }
VERSION : 0.1
// Khối dữ liệu đệm truyền thông (Modbus TCP Client/Server và Modbus RTU ATV12)
// Thiết kế Standard (Non-Optimized) để đảm bảo độ lệch địa chỉ byte (byte offset) cố định cho con trỏ Modbus
   STRUCT
      // 1. Cấu hình kết nối Modbus TCP Client (Giao tiếp từ PLC1 -> PLC2, sử dụng trên PLC1)
      MB_TCP_Client_Conn : TCON_IP_v4;   // Cấu trúc cấu hình kết nối TCP Client chuẩn Siemens
      
      // 2. Cấu hình kết nối Modbus TCP Server (Lắng nghe từ PLC1, sử dụng trên PLC2)
      MB_TCP_Server_Conn : TCON_IP_v4;   // Cấu trúc cấu hình kết nối TCP Server chuẩn Siemens
      
      // 3. Trạng thái điều phối và bộ đệm giao tiếp Modbus TCP Client
      TCP_Client : "UDT_ModbusTCP_Link";  // Quản lý trạng thái, nhãn bắt tay và bộ đệm gửi nhận
      
      // 4. Trạng thái điều phối và bộ đệm giao tiếp Modbus TCP Server
      TCP_Server : "UDT_ModbusTCP_Link";  // Quản lý trạng thái, nhãn bắt tay và bộ đệm lưu trữ dữ liệu chia sẻ
      
      // 5. Trạng thái và bộ đệm truyền thông Modbus RTU RS485 với biến tần Altivar 12 Bồn 2 (Chỉ chạy trên PLC1)
      VFD_Bon2 : "UDT_VFD_ATV12";         // Trạng thái và dữ liệu điều khiển biến tần
   END_STRUCT;
BEGIN
   // Thiết lập giá trị khởi động mặc định (Start Values) để tránh lỗi truyền thông 16#80B6
   
   // --- CẤU HÌNH MODBUS TCP CLIENT (PLC1) ---
   MB_TCP_Client_Conn.InterfaceId := 64;           // Cổng Ethernet X1 tích hợp của S7-1200
   MB_TCP_Client_Conn.ID := 5;                     // Connection ID (Cố định trùng khớp giữa Client và Server)
   MB_TCP_Client_Conn.ConnectionType := 11;        // Kiểu kết nối 11 = 16#0B (giao thức TCP)
   MB_TCP_Client_Conn.ActiveEstablished := TRUE;   // PLC1 đóng vai trò chủ động kết nối (Client)
   MB_TCP_Client_Conn.RemoteAddress.ADDR[1] := 192; // Địa chỉ IP đích (PLC2 Server) ADDR[1..4]
   MB_TCP_Client_Conn.RemoteAddress.ADDR[2] := 168;
   MB_TCP_Client_Conn.RemoteAddress.ADDR[3] := 0;
   MB_TCP_Client_Conn.RemoteAddress.ADDR[4] := 2;   // PLC2 IP = 192.168.0.2
   MB_TCP_Client_Conn.RemotePort := 502;           // Cổng dịch vụ Modbus TCP mặc định của PLC2
   MB_TCP_Client_Conn.LocalPort := 0;             // Cổng local tự động cấp phát (0)
   
   // --- CẤU HÌNH MODBUS TCP SERVER (PLC2) ---
   MB_TCP_Server_Conn.InterfaceId := 64;           // Cổng Ethernet X1 tích hợp của PLC2
   MB_TCP_Server_Conn.ID := 5;                     // Connection ID (Cố định trùng khớp)
   MB_TCP_Server_Conn.ConnectionType := 11;        // Kiểu kết nối TCP
   MB_TCP_Server_Conn.ActiveEstablished := FALSE;  // PLC2 đóng vai trò thụ động lắng nghe kết nối (Server)
   MB_TCP_Server_Conn.RemoteAddress.ADDR[1] := 192; // Chỉ chấp nhận kết nối từ IP này (PLC1 Client)
   MB_TCP_Server_Conn.RemoteAddress.ADDR[2] := 168;
   MB_TCP_Server_Conn.RemoteAddress.ADDR[3] := 0;
   MB_TCP_Server_Conn.RemoteAddress.ADDR[4] := 1;   // PLC1 IP = 192.168.0.1
   MB_TCP_Server_Conn.RemotePort := 0;             // Chấp nhận mọi cổng gửi từ Client
   MB_TCP_Server_Conn.LocalPort := 502;           // Lắng nghe trên cổng Modbus TCP 502
END_DATA_BLOCK
