DATA_BLOCK "DB_RealIO_Map"
{ S7_Optimized_Access := 'True' }
VERSION : 0.1
// Khối dữ liệu đệm trung gian ánh xạ các ngõ vào/ra vật lý thực tế (Real_IO) cho Variant B.
// Việc ánh xạ (mapping) hai chiều giữa các biến DB này và địa chỉ vật lý %I/%Q sẽ được thực hiện 
// ở đầu và cuối vòng quét OB1 để tăng tính cấu trúc và dễ dàng test/chuyển đổi mô phỏng.
   STRUCT
      // --- NGÕ VÀO VẬT LÝ (PLC1 - Ánh xạ từ vùng nhớ %I ở đầu vòng quét OB1) ---
      Nut_Start_Physical : Bool := FALSE;   // Nút nhấn chạy hệ thống vật lý (%I0.0)
      Nut_Stop_Physical : Bool := FALSE;    // Nút nhấn dừng hệ thống vật lý (%I0.1)
      Nut_Reset_Physical : Bool := FALSE;   // Nút nhấn Reset lỗi vật lý (%I0.2)
      Nut_EStop_Physical : Bool := FALSE;   // Nút nhấn dừng khẩn cấp vật lý (%I0.3)
      
      // --- NGÕ RA ĐIỀU KHIỂN THỰC TẾ (PLC1 - Ánh xạ ra vùng nhớ %Q ở cuối vòng quét OB1) ---
      VFD_Bon2_Contactor : Bool := FALSE;   // Contactor cấp nguồn/enable cho biến tần ATV12 Bồn 2 (%Q0.0)
      
      // --- LƯU Ý PHÂN ĐỊNH SIM_IO ---
      // Mọi van, cảm biến mức, cảm biến nhiệt, lưu lượng, phao mức nếu chưa có bảng đấu nối xác nhận
      // thì đều được định nghĩa là Sim_IO và xử lý mô phỏng hoàn toàn trong DB_Operation/DB_HMI.
      // Không được tự ý ánh xạ các tín hiệu Sim_IO này vào ngõ vào/ra vật lý (%I, %Q).
   END_STRUCT;
BEGIN
END_DATA_BLOCK

